# Copy to infisical.env (same directory as the *.container units) and fill in.
# NEVER commit infisical.env — only this example file belongs in git.
POSTGRES_USER=infisical
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=infisical
